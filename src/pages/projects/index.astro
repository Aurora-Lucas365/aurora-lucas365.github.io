---
// 项目列表：按类别分组
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, byDateDesc } from "../../utils";

const projects = (await getCollection("projects")).sort(byDateDesc);
const groups = ["嵌入式", "数学建模", "软件"]
  .map((name) => ({ name, items: projects.filter((p) => p.data.category === name) }))
  .filter((g) => g.items.length > 0);
---
<Base title="项目">
  <h1>项目</h1>
  <p class="muted">做过和正在做的项目，按类别分组。</p>
  {groups.length === 0 && <p class="muted">还没有公开的项目。</p>}
  {groups.map((g) => (
    <section>
      <h2>{g.name}</h2>
      <ul class="list">
        {g.items.map((p) => (
          <li>
            <a href={`/projects/${p.id}/`}>{p.data.title}</a>
            {p.data.draft && <span class="tag draft">草稿</span>}
            <div class="meta">{p.data.status} · {formatDate(p.data.date)}</div>
            {p.data.summary && <div>{p.data.summary}</div>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
