---
// 所有页面共用的外壳：网页标题、顶部导航、底部信息，以及全站的颜色、字体和动画。
// 用法：<Base title="页面标题" tone="white"> 页面内容 </Base>
//   tone：页面底色，grey（浅灰，默认）或 white（白）
import { SITE_NAME, CONTACT } from "../utils";

interface Props {
  title?: string;
  description?: string;
  tone?: "grey" | "white";
  image?: string;
}
const { title, description = "Lucas Taylor 的个人网站：记录项目和学习的历程。", tone = "grey", image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects/", label: "项目" },
  { href: "/journal/", label: "历程" },
  { href: "/about/", label: "关于" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <!-- 等宽字体：不阻塞页面，加载不到（比如国内网络）就用电脑自带的等宽字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class={`tone-${tone}`}>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/">{SITE_NAME}</a>
        <nav>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap bar">
        <span>© {new Date().getFullYear()} {SITE_NAME} · 内容来自我的 Obsidian 笔记</span>
        <span class="links">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.github}>GitHub</a>
          <a href={CONTACT.douyin}>抖音</a>
        </span>
      </div>
    </footer>

    <!-- 滚动出现：带 data-reveal 的元素进入屏幕时淡入上移 -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window)) { els.forEach(function (el) { el.classList.add("in"); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
        }, { rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* ============ 颜色、字体（改这里就能换全站风格） ============ */
  :root {
    --bg: #f4f5f6;        /* 浅灰底 */
    --surface: #ffffff;   /* 白色卡片 / 白色区块 */
    --fg: #1a1c1e;        /* 标题文字 */
    --fg2: #3a3f44;       /* 正文文字 */
    --muted: #5b6168;     /* 次要文字 */
    --num: #8a9098;       /* 卡片里的大数字 */
    --line: #e1e3e6;      /* 分隔线 */
    --accent: #0b57d0;    /* 链接、按钮 */
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    --mono: "IBM Plex Mono", "JetBrains Mono", "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    color-scheme: light;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--sans); font-size: 17px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  body.tone-white { background: var(--surface); }
  body { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1 0 auto; }
  img { max-width: 100%; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  h1, h2, h3 { margin: 0; color: var(--fg); }

  /* 页面切换时淡入淡出（新版 Chrome / Edge / Safari 支持，其他浏览器直接跳转） */
  @view-transition { navigation: auto; }

  /* ============ 版心 ============ */
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 32px; }
  .band { background: var(--surface); }
  .band.grey { background: var(--bg); }
  @media (max-width: 640px) { .wrap { padding: 0 20px; } }

  /* ============ 顶部导航 ============ */
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(244, 245, 246, 0.82); border-bottom: 1px solid var(--line); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); }
  .tone-white .site-header { background: rgba(255, 255, 255, 0.82); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
  .site-header .bar { min-height: 52px; font-size: 14px; }
  .logo { color: var(--fg); font-weight: 700; }
  .site-header nav { display: flex; gap: 28px; }
  .site-header nav a { color: var(--muted); }
  .site-header nav a:hover { color: var(--fg); text-decoration: none; }
  .site-header nav a[aria-current="page"] { color: var(--fg); font-weight: 500; }
  @media (max-width: 480px) { .site-header nav { gap: 18px; } }

  /* ============ 底部 ============ */
  .site-footer { border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  .site-footer .bar { padding-top: 32px; padding-bottom: 48px; }
  .site-footer .links { display: flex; flex-wrap: wrap; gap: 20px; }
  .site-footer a { color: var(--muted); }
  .site-footer a:hover { color: var(--fg); }

  /* ============ 大标题区（每页顶部） ============ */
  .hero { text-align: center; padding-top: 104px; padding-bottom: 72px; }
  .eyebrow { margin: 0 0 16px; font-size: 18px; font-weight: 500; color: var(--muted); display: flex; flex-wrap: wrap; gap: 10px 14px; justify-content: center; align-items: center; }
  .hero h1 { font-size: clamp(42px, 7vw, 80px); line-height: 1.1; font-weight: 900; letter-spacing: -0.02em; }
  .hero .sub { margin: 24px auto 0; max-width: 32em; font-size: clamp(18px, 2.2vw, 21px); line-height: 1.65; font-weight: 300; color: var(--fg2); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 36px; }
  .btn { display: inline-block; padding: 12px 24px; border-radius: 999px; font-size: 16px; font-weight: 500; transition: background 0.2s; }
  .btn:hover { text-decoration: none; }
  .btn.primary { background: var(--accent); color: #fff; }
  .btn.primary:hover { background: #0947ad; }
  .btn.ghost { color: var(--accent); }
  .btn.ghost:hover { text-decoration: underline; }
  @media (max-width: 640px) { .hero { padding-top: 72px; padding-bottom: 48px; } }

  /* 区块标题 */
  .section-title { font-size: clamp(30px, 4vw, 40px); font-weight: 900; letter-spacing: -0.01em; margin-bottom: 28px; }
  .section { padding-top: 96px; padding-bottom: 96px; }
  @media (max-width: 640px) { .section { padding-top: 64px; padding-bottom: 64px; } }

  /* ============ 工程细节：分类色标签、状态符号、等宽字 ============ */
  .mono { font-family: var(--mono); }
  .tag { display: inline-block; font-family: var(--mono); font-size: 12px; line-height: 1.5; font-weight: 500; padding: 2px 8px; border: 1px solid currentColor; border-radius: 4px; color: var(--muted); background: transparent; white-space: nowrap; }
  .tag.c-emb { color: #00707a; background: #d9eced; }
  .tag.c-math { color: #9a5a00; background: #f4e9d9; }
  .tag.c-soft { color: #a02f69; background: #f3dfe8; }
  .tag.draft { color: #b45309; background: #fff4e5; }
  .status { font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .status .dot { margin-right: 4px; }
  .s-done .dot { color: #1a7f37; }
  .s-doing .dot { color: var(--accent); }
  .s-paused .dot { color: var(--num); }

  /* ============ 卡片 ============ */
  .grid { display: flex; flex-wrap: wrap; gap: 20px; }
  .card { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 12px; padding: 40px; background: var(--surface); border-radius: 28px; color: var(--fg); transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease); }
  a.card:hover { text-decoration: none; transform: translateY(-4px); box-shadow: 0 16px 40px rgba(26, 28, 30, 0.08); }
  .card h3 { font-size: 28px; line-height: 1.25; font-weight: 900; }
  .card p { margin: 0; font-size: 16px; line-height: 1.7; color: var(--fg2); }
  .card .more { font-size: 16px; color: var(--accent); }
  .meta-row { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; }
  @media (max-width: 640px) { .card { padding: 28px; border-radius: 24px; } }

  /* ============ 笔记正文排版 ============ */
  .prose { max-width: 720px; margin: 0 auto; font-size: 18px; line-height: 1.85; color: var(--fg2); }
  .prose > :first-child { margin-top: 0; }
  .prose h2 { margin: 72px 0 20px; font-size: clamp(26px, 3.2vw, 34px); line-height: 1.3; font-weight: 900; letter-spacing: -0.01em; }
  .prose h3 { margin: 40px 0 12px; font-size: 22px; font-weight: 700; }
  .prose p, .prose ul, .prose ol { margin: 0 0 1.1em; }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose li { margin: 0.45em 0; }
  .prose li::marker { color: var(--num); }
  .prose strong { color: var(--fg); font-weight: 700; }
  .prose a { text-decoration: underline; text-decoration-color: rgba(11, 87, 208, 0.35); text-underline-offset: 3px; }
  .prose a:hover { text-decoration-color: currentColor; }
  .prose img { display: block; width: 100%; height: auto; margin: 32px 0; border-radius: 20px; }
  .prose blockquote { margin: 32px 0; padding: 24px 28px; background: var(--bg); border-radius: 20px; font-size: 16px; line-height: 1.75; }
  .tone-grey .prose blockquote { background: var(--surface); }
  .prose blockquote p:last-child { margin-bottom: 0; }
  .prose code { font-family: var(--mono); font-size: 0.88em; padding: 2px 6px; background: var(--bg); border-radius: 6px; }
  .prose pre { padding: 20px 24px; border-radius: 16px; overflow-x: auto; font-size: 14px; line-height: 1.6; }
  .prose pre code { padding: 0; background: none; }
  .prose table { width: 100%; margin: 24px 0; border-collapse: collapse; font-size: 16px; }
  .prose th, .prose td { padding: 12px 8px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .prose th { color: var(--fg); font-weight: 700; }
  .prose hr { margin: 56px 0; border: 0; border-top: 1px solid var(--line); }
  .prose mark { background: #fff1b8; color: inherit; padding: 0 2px; border-radius: 3px; }

  /* ============ 滚动出现动画 ============ */
  .js [data-reveal] { opacity: 0; transform: translateY(28px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); transition-delay: var(--d, 0ms); }
  .js [data-reveal].in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .js [data-reveal] { opacity: 1; transform: none; transition: none; }
    a.card:hover { transform: none; }
    @view-transition { navigation: none; }
  }
</style>
