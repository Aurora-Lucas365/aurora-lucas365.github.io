---
// 所有页面共用的外壳：网页标题、顶部导航、底部信息。
// 用法：<Base title="页面标题"> 页面内容 </Base>
import { SITE_NAME } from "../utils";

interface Props {
  title?: string;
  description?: string;
}
const { title, description = "Lucas Taylor 的个人网站：记录项目和学习的历程。" } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "首页" },
  { href: "/projects/", label: "项目" },
  { href: "/journal/", label: "历程" },
  { href: "/about/", label: "关于" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/">{SITE_NAME}</a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {SITE_NAME} · 内容来自我的 Obsidian 笔记</p>
    </footer>
  </body>
</html>

<style is:global>
  /* 暂时只做最基本的排版，视觉设计放到后面 */
  :root {
    --bg: #fbfbfa; --fg: #1d2125; --muted: #5d6670; --line: #e3e6e8; --accent: #2457c5;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #14171a; --fg: #e6e9ec; --muted: #9aa4ad; --line: #2a3036; --accent: #7fa4ff; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    font-size: 16px; line-height: 1.75;
  }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; border-radius: 6px; }
  .site-header, main, .site-footer { max-width: 760px; margin: 0 auto; padding-inline: 20px; }
  .site-header {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    padding-block: 20px; border-bottom: 1px solid var(--line);
  }
  .logo { font-weight: 700; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 18px; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a[aria-current="page"] { color: var(--fg); font-weight: 600; }
  main { padding-block: 32px 48px; }
  h1 { font-size: 1.9rem; line-height: 1.3; margin: 0 0 8px; }
  h2 { font-size: 1.3rem; margin: 40px 0 12px; }
  .muted { color: var(--muted); }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .list a { font-weight: 600; text-decoration: none; }
  .meta { font-size: 13px; color: var(--muted); }
  .tag {
    display: inline-block; font-size: 12px; padding: 0 8px; margin-right: 6px;
    border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
  }
  .draft { border-color: #d97706; color: #d97706; margin-left: 8px; }
  blockquote { margin: 16px 0; padding: 8px 16px; border-left: 3px solid var(--line); color: var(--muted); }
  .site-footer { padding-block: 24px 40px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
</style>
