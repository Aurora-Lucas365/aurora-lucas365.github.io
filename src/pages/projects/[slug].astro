---
// 单个项目的详情页。文件名里的 [slug] 表示：每个项目都会用这个模板生成一页。
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <p class="meta"><a href="/projects/">← 全部项目</a></p>
  <h1>{d.title}</h1>
  <p class="meta">
    {d.category} · {d.status} · {formatDate(d.date)}
    {d.draft && <span class="tag draft">草稿</span>}
  </p>
  <p>{d.tags.map((t) => <span class="tag">{t}</span>)}</p>
  <article>
    <Content />
  </article>
</Base>
